# Copy this file to .env and fill in real values. Never commit the real .env.

# Base URL of the backend API. In dev this can be left unset (Vite's proxy
# in vite.config.js forwards /api to localhost:8000); set it explicitly for
# any deployed build so the app doesn't fall back to same-origin routing.
VITE_API_URL=http://localhost:8000/api
