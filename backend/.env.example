# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB connection string (required)
MONGO_URI=mongodb://localhost:27017/campus_resource_manager

# Port the API listens on (required)
PORT=8000

# Secret used to sign session cookies — required, use a long random string in
# production (e.g. `openssl rand -hex 32`). Never reuse the dev value below.
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated list of frontend origins allowed by CORS
CLIENT_URL=http://localhost:5173

# Set to "production" on a real deployment (enables secure cookies, etc.)
NODE_ENV=development

# Google Gemini API key — optional. Powers AI demand insights and the
# LLM-based path of the NLP booking assistant. Without it, both features
# fall back to their deterministic/statistical logic.
GEMINI_API_KEY=

# Python interpreter used to run the Prophet forecasting script — optional,
# defaults to "python3". Set this if your host's interpreter is named
# differently (e.g. "python" on some Windows/dev setups).
PYTHON_BIN=python3

# Nodemailer (Gmail) credentials for underutilization alert emails — optional.
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=
